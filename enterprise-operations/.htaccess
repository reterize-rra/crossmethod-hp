Options -Indexes -MultiViews
DirectoryIndex index.html
AddType text/javascript .mjs .js
AddType application/json .json
SetEnvIf Request_URI "^/enterprise-operations/" Ngx_Cache_NoCacheMode=on
SetEnvIf Request_URI "^/enterprise-operations/" !Ngx_Cache_AllCacheMode
Header always set Cache-Control "no-store, max-age=0"
Header always set Pragma "no-cache"
Header always set Expires "0"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https://uxsdddejthdpoxghuzca.supabase.co; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
<FilesMatch "^(\.|.*\.(py|ts|map|env|log|bak|zip)$)">
Require all denied
</FilesMatch>
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^tsunagari-jp\.com$ [NC]
RewriteRule ^ - [F,L]
